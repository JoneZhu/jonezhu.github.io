---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import YearNav from '../../components/YearNav.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts } from '../../lib/posts.mjs';
import { paginate } from '../../lib/urls.mjs';
import { site } from '../../site.config.mjs';

const { posts } = getPosts();
const first = paginate(posts, site.perPage)[0];
---

<BaseLayout title="归档" description={`${site.title}全部文章归档，共 ${posts.length} 篇。`}>
  <div class="wrap">
    <PageHeader kicker="归档" title="文章归档" description={`共 ${posts.length} 篇，按年月排列。`} />
    <YearNav />
    <ArchiveList posts={first.items} />
    <Pagination current={first.page} total={first.totalPages} base="/archives/" />
  </div>
</BaseLayout>
