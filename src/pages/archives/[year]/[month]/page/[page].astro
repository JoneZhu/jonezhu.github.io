---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import PageHeader from '../../../../../components/PageHeader.astro';
import ArchiveList from '../../../../../components/ArchiveList.astro';
import Pagination from '../../../../../components/Pagination.astro';
import { getArchiveData } from '../../../../../lib/archives.mjs';
import { paginate } from '../../../../../lib/urls.mjs';
import { site } from '../../../../../site.config.mjs';

export function getStaticPaths() {
  const pages = [];
  for (const entry of getArchiveData()) {
    for (const m of entry.months) {
      for (const p of paginate(m.posts, site.perPage)) {
        if (p.page === 1) continue;
        pages.push({
          params: {
            year: String(entry.year),
            month: String(m.month).padStart(2, '0'),
            page: String(p.page),
          },
          props: {
            year: entry.year,
            month: m.month,
            items: p.items,
            page: p.page,
            totalPages: p.totalPages,
          },
        });
      }
    }
  }
  return pages;
}

const { year, month, items, page, totalPages } = Astro.props;
const monthLabel = `${year} 年 ${String(month).padStart(2, '0')} 月`;
---

<BaseLayout title={`${monthLabel}归档 · 第 ${page} 页`} description={`${site.title} ${monthLabel}归档，第 ${page} 页。`} noindex>
  <div class="wrap">
    <PageHeader kicker="归档" title={monthLabel} description={`第 ${page} / ${totalPages} 页`} />
    <ArchiveList posts={items} grouped={false} />
    <Pagination current={page} total={totalPages} base={`/archives/${year}/${String(month).padStart(2, '0')}/`} />
  </div>
</BaseLayout>
