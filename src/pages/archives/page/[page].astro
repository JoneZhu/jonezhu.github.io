---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import YearNav from '../../../components/YearNav.astro';
import ArchiveList from '../../../components/ArchiveList.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPosts } from '../../../lib/posts.mjs';
import { paginate } from '../../../lib/urls.mjs';
import { site } from '../../../site.config.mjs';

export function getStaticPaths() {
  const { posts } = getPosts();
  return paginate(posts, site.perPage)
    .filter((p) => p.page > 1)
    .map((p) => ({
      params: { page: String(p.page) },
      props: { items: p.items, page: p.page, totalPages: p.totalPages },
    }));
}

const { items, page, totalPages } = Astro.props;
---

<BaseLayout title={`归档 · 第 ${page} 页`} description={`${site.title}归档，第 ${page} 页。`} noindex>
  <div class="wrap">
    <PageHeader kicker="归档" title="文章归档" description={`第 ${page} / ${totalPages} 页`} />
    <YearNav />
    <ArchiveList posts={items} />
    <Pagination current={page} total={totalPages} base="/archives/" />
  </div>
</BaseLayout>
