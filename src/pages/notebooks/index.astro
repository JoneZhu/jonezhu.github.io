---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="笔记" description="旧笔记页面入口，已指向站点首页。" noindex>
  <div class="wrap not-found">
    <h1 class="not-found__title">笔记</h1>
    <p class="not-found__desc">该旧页面暂无独立内容，请从首页或文章列表继续阅读。</p>
    <p class="not-found__actions">
      <a class="button" href="/">回到首页</a>
      <a class="button button--ghost" href="/blog/">浏览全部文章</a>
    </p>
  </div>
</BaseLayout>
