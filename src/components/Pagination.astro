---
import { pageUrl } from '../lib/urls.mjs';

interface Props {
  current: number;
  total: number;
  /** 以 / 结尾的基础路径。 */
  base: string;
}

const { current, total, base } = Astro.props;

/** 生成带省略号的页码序列。 */
function pageItems(current: number, total: number): Array<number | '…'> {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const items: Array<number | '…'> = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  if (start > 2) items.push('…');
  for (let i = start; i <= end; i++) items.push(i);
  if (end < total - 1) items.push('…');
  items.push(total);
  return items;
}

const items = pageItems(current, total);
---

{total > 1 && (
  <nav class="pager" aria-label="分页">
    <ul class="pager__list">
      <li class="pager__item">
        {current > 1 ? (
          <a class="pager__link" href={pageUrl(base, current - 1)} rel="prev">上一页</a>
        ) : (
          <span class="pager__link is-disabled" aria-disabled="true">上一页</span>
        )}
      </li>
      {items.map((item) =>
        item === '…' ? (
          <li class="pager__item"><span class="pager__gap" aria-hidden="true">…</span></li>
        ) : (
          <li class="pager__item">
            {item === current ? (
              <span class="pager__link is-current" aria-current="page">{item}</span>
            ) : (
              <a class="pager__link" href={pageUrl(base, item)}>{item}</a>
            )}
          </li>
        ),
      )}
      <li class="pager__item">
        {current < total ? (
          <a class="pager__link" href={pageUrl(base, current + 1)} rel="next">下一页</a>
        ) : (
          <span class="pager__link is-disabled" aria-disabled="true">下一页</span>
        )}
      </li>
    </ul>
  </nav>
)}
